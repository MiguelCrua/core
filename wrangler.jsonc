{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "core",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-17",
  "build": { "command": "node cloudflare/build.mjs" },
  "ratelimits": [{ "name": "WORKBOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
